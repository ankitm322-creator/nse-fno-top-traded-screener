const tableBody = document.getElementById('tableBody');
const limitSelect = document.getElementById('limitSelect');
const searchInput = document.getElementById('searchInput');
const refreshBtn = document.getElementById('refreshBtn');
const sourceLabel = document.getElementById('sourceLabel');
const updatedAt = document.getElementById('updatedAt');

let currentRows = [];

function formatCurrency(value) {
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0,
    notation: 'compact'
  }).format(Number(value || 0));
}

function formatNumber(value) {
  return new Intl.NumberFormat('en-IN', {
    maximumFractionDigits: 2,
    notation: 'compact'
  }).format(Number(value || 0));
}

function formatPrice(value) {
  return new Intl.NumberFormat('en-IN', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(Number(value || 0));
}

function getChangeClass(value) {
  return Number(value) >= 0 ? 'positive' : 'negative';
}

function renderRows() {
  const query = searchInput.value.trim().toLowerCase();
  const filtered = currentRows.filter((row) => row.symbol.toLowerCase().includes(query));

  if (!filtered.length) {
    tableBody.innerHTML = `
      <tr>
        <td colspan="7" class="empty-state">No matching stocks found</td>
      </tr>
    `;
    return;
  }

  tableBody.innerHTML = filtered.map((row) => {
    const changeClass = getChangeClass(row.dayChange);
    const rangeText = `${formatPrice(row.low)} - ${formatPrice(row.high)}`;
    return `
      <tr>
        <td class="rank">${row.rank}</td>
        <td class="symbol-cell">${row.symbol}</td>
        <td>₹ ${formatPrice(row.ltp)}</td>
        <td>₹ ${formatCurrency(row.tradedValue)}</td>
        <td>${formatNumber(row.volume)}</td>
        <td class="${changeClass}">${Number(row.dayChange || 0).toFixed(2)}%</td>
        <td>${rangeText}</td>
      </tr>
    `;
  }).join('');
}

async function fetchTopTradedStocks() {
  const limit = limitSelect.value;
  const response = await fetch(`/api/top-traded-fno?limit=${limit}`);
  const payload = await response.json();

  currentRows = Array.isArray(payload.data) ? payload.data : [];
  sourceLabel.textContent = payload.source === 'live' ? 'FYERS live data' : 'Demo mode';
  sourceLabel.style.color = payload.source === 'live' ? '#7dd3fc' : '#fbbf24';

  const dot = document.querySelector('.status-dot');
  if (dot) {
    dot.style.background = payload.source === 'live' ? '#22c55e' : '#fbbf24';
    dot.style.boxShadow = payload.source === 'live'
      ? '0 0 12px rgba(34, 197, 94, 0.9)'
      : '0 0 12px rgba(251, 191, 36, 0.9)';
  }

  updatedAt.textContent = new Date(payload.generatedAt).toLocaleTimeString('en-IN', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  });

  renderRows();
}

limitSelect.addEventListener('change', fetchTopTradedStocks);
searchInput.addEventListener('input', renderRows);
refreshBtn.addEventListener('click', fetchTopTradedStocks);

fetchTopTradedStocks();
setInterval(fetchTopTradedStocks, 60000);
